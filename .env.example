# PostgreSQL. Utilisez sslmode=require pour une base distante.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rouky?schema=public"
# Optionnel : connexion directe pour Prisma db push si DATABASE_URL utilise un pooler.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/rouky?schema=public&sslmode=require"
# Au moins 32 caractères aléatoires. Générer avec : openssl rand -base64 48
AUTH_SECRET=""
